# Copy to .env for local development.
# `docker compose up -d` at the repo root provides Postgres and Redis on these
# addresses.

# Runtime mode for Node and its libraries. Deployed environments — staging
# included — set this to `production` so they execute the same optimized code
# paths production will.
NODE_ENV=development

# Which deployment this is: local | staging | production.
# Guards the unsafe operations. Seeding refuses `production`, and the
# development JWT secret is refused anywhere but `local`.
APP_ENV=local

PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgres://aura:aura@localhost:5432/aura
DATABASE_POOL_MAX=10
# Managed Postgres usually terminates TLS with its own certificate authority.
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug

# Comma-separated origins, or * to allow any.
CORS_ORIGINS=*

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Per-user like budget (TS-04). Upload daily quota is MEDIA_DAILY_UPLOAD_QUOTA.
LIKE_RATE_LIMIT_MAX=60
LIKE_RATE_LIMIT_WINDOW_MS=60000

# Trending scoring. Tunable without a deploy; see docs/backend-architecture.md §8.2.
TRENDING_INTERVAL_MS=30000
TRENDING_MAX_POSTS=5000
TRENDING_WINDOW_MINUTES=15
TRENDING_HALF_LIFE_HOURS=18
TRENDING_MAX_AGE_HOURS=168
TRENDING_BASE_VELOCITY=0.05

# Identity providers. Sign-in is refused until these are set. APPLE_CLIENT_ID is
# the iOS bundle id. GOOGLE_CLIENT_IDS is a comma-separated list of iOS, Android
# and web OAuth client ids — the token `aud` has to match one of them. No Google
# client secret on the API: it verifies ID tokens against Google's JWKS.
# APPLE_CLIENT_ID=app.aura.mobile
# GOOGLE_CLIENT_IDS=37586478648-lje8e40652sgi8pl7hmogjd7ns6qmj5f.apps.googleusercontent.com,37586478648-trc2amkrb29fv6h9undhkljfd7t69llh.apps.googleusercontent.com

# Cloudflare R2. The API never proxies file bytes — clients PUT to a presigned
# URL, and the feed serves https://cdn.aurarankd.com/... (or the r2.dev URL until
# that custom domain is attached). Secrets stay out of git.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=aura-media
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
MEDIA_CDN_BASE_URL=https://cdn.aurarankd.com
MEDIA_EDGE=none
MEDIA_DAILY_UPLOAD_QUOTA=20
