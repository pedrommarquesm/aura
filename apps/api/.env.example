# Copy to .env for local development.
# `docker compose up -d` at the repo root provides Postgres and Redis on these
# addresses.

# Runtime mode for Node and its libraries. Deployed environments — staging
# included — set this to `production` so they execute the same optimized code
# paths production will.
NODE_ENV=development

# Which deployment this is: local | staging | production.
# Guards the unsafe operations. Seeding refuses `production`, and the
# development JWT secret is refused anywhere but `local`.
APP_ENV=local

PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgres://aura:aura@localhost:5432/aura
DATABASE_POOL_MAX=10
# Managed Postgres usually terminates TLS with its own certificate authority.
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug

# Comma-separated origins, or * to allow any.
CORS_ORIGINS=*

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Per-user vote budget (TS-04). Every vote is a permanent, capped economic
# event, not a togglable like. Upload daily quota is MEDIA_DAILY_UPLOAD_QUOTA.
VOTE_RATE_LIMIT_MAX=30
VOTE_RATE_LIMIT_WINDOW_MS=60000

# Trending scoring. Tunable without a deploy; see docs/backend-architecture.md §8.2.
TRENDING_INTERVAL_MS=30000
TRENDING_MAX_POSTS=5000
TRENDING_WINDOW_MINUTES=15
TRENDING_HALF_LIFE_HOURS=18
TRENDING_MAX_AGE_HOURS=168
TRENDING_BASE_VELOCITY=0.05

# Identity providers. Sign-in is refused until these are set. APPLE_CLIENT_ID is
# the iOS bundle id. GOOGLE_CLIENT_IDS is a comma-separated list of iOS, Android
# and web OAuth client ids — the token `aud` has to match one of them. No Google
# client secret on the API: it verifies ID tokens against Google's JWKS.
# APPLE_CLIENT_ID=app.aurarankd.mobile
# GOOGLE_CLIENT_IDS=37586478648-lje8e40652sgi8pl7hmogjd7ns6qmj5f.apps.googleusercontent.com,37586478648-trc2amkrb29fv6h9undhkljfd7t69llh.apps.googleusercontent.com

# Password login / register. Always off when APP_ENV=production. Used for e2e.
# PASSWORD_AUTH_MAX=20
# PASSWORD_AUTH_WINDOW_MS=60000
# E2E_TEST_EMAIL=e2e@auraclimb.test
# E2E_TEST_PASSWORD=e2e-test-password-0001

# Cloudflare R2. The API never proxies file bytes — clients PUT to a presigned
# URL, and the feed serves https://cdn.auraclimb.com/... (or the r2.dev URL until
# that custom domain is attached). Secrets stay out of git.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=aura-media
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
MEDIA_CDN_BASE_URL=https://cdn.auraclimb.com
MEDIA_EDGE=none
MEDIA_DAILY_UPLOAD_QUOTA=20
# MEDIA_AVATAR_MAX_BYTES=2097152

# Mux Video. Token pair on api + worker. Webhook HMAC is api only and is
# not the same value as the API token. Unset parks video ingest (photos still
# work). Never put these in NEXT_PUBLIC_* or the app.
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=

# Shared secret for POST /v1/moderation/* (header X-Moderation-Key).
# Unset parks the key path; staff JWTs from the admin app still work.
# Generate with: openssl rand -base64 32
# MODERATION_SECRET=

# Backoffice. Staff lives in its own tables — never on `users`.
# The owner email is invited on boot and claimed on first Google sign-in.
STAFF_OWNER_EMAIL=pedrommarquesm@gmail.com
# Comma-separated domains that may auto-join as moderator. Empty = invite-only.
# STAFF_ALLOWED_DOMAINS=auraclimb.com

# Canonical web origin for waitlist referral links and emails.
PUBLIC_SITE_URL=https://www.auraclimb.com
WAITLIST_ENABLED=true
WAITLIST_RATE_LIMIT_MAX=8
WAITLIST_RATE_LIMIT_WINDOW_MS=3600000
WAITLIST_EMAIL_RATE_LIMIT_MAX=5
WAITLIST_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
WAITLIST_GLOBAL_RATE_LIMIT_MAX=200
WAITLIST_GLOBAL_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_EMAIL_RATE_LIMIT_MAX=3
CONTACT_EMAIL_RATE_LIMIT_WINDOW_MS=3600000

# Mail. Unset parks sending — rendered emails stay in email_outbox as queued.
# RESEND_API_KEY=
# MAIL_FROM=Aura <hello@auraclimb.com>
