# Base URL of the Aura API, including the version prefix.
# Defaults to staging if unset. Point at local docker-compose with:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3333/v1
EXPO_PUBLIC_API_URL=https://api-production-aa71.up.railway.app/v1

# Google OAuth client ids. The API's GOOGLE_CLIENT_IDS must include whichever
# `aud` the ID token carries (iOS, Android, and the web/Expo Go client differ).
# Sign in with Apple uses the iOS bundle id `app.aura.mobile` as APPLE_CLIENT_ID
# on the API — no client secret lives in the app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
