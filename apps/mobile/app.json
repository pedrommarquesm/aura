{
  "expo": {
    "name": "Aura",
    "slug": "aura",
    "scheme": [
      "aura",
      "com.googleusercontent.apps.37586478648-lje8e40652sgi8pl7hmogjd7ns6qmj5f"
    ],
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.aura.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Aura uses your photo library so you can post.",
        "NSCameraUsageDescription": "Aura uses the camera so you can post."
      }
    },
    "android": {
      "package": "app.aura.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aura uses your photo library so you can post.",
          "cameraPermission": "Aura uses the camera so you can post.",
          "microphonePermission": "Aura uses the microphone when you record a video."
        }
      ],
      "expo-file-system",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.37586478648-lje8e40652sgi8pl7hmogjd7ns6qmj5f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
