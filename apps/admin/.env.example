# Copy to .env.local for local development.
# `npm run dev` serves the backoffice on http://localhost:3001

# Aura API. Staging is https://api.auraclimb.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# Public origin of this app. NextAuth uses it for callbacks.
AUTH_URL=http://localhost:3001

# NextAuth cookie encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-admin-auth-secret-0000

# Required on Railway / any host that sits behind a proxy.
AUTH_TRUST_HOST=true

# Same Web application OAuth client as the public site is fine. Add
# http://localhost:3001/api/auth/callback/google (and the deployed admin
# origin) as an Authorized redirect URI in Google Cloud Console.
AUTH_GOOGLE_ID=37586478648-trc2amkrb29fv6h9undhkljfd7t69llh.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=
