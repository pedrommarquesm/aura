# Public site origin. Used for canonical URLs, Open Graph and the sitemap.
# Staging's canonical host is https://aurarankd.com (`www` 308s there).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Aura API. Staging public origin is https://api.aurarankd.com.
NEXT_PUBLIC_API_BASE_URL=https://api.aurarankd.com

# Serve local mock posters instead of calling the API.
NEXT_PUBLIC_USE_MOCK_API=false

# Google Identity Services web client id (type: Web application). Public — it
# ships in the browser. The API's GOOGLE_CLIENT_IDS must include this value.
# Authorized JavaScript origins: http://localhost:3000, the Railway web URL,
# https://aurarankd.com and https://www.aurarankd.com.
# The client secret is not used by GIS; keep it in Railway as GOOGLE_CLIENT_SECRET,
# never in NEXT_PUBLIC_* and never in git.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=37586478648-trc2amkrb29fv6h9undhkljfd7t69llh.apps.googleusercontent.com

# Store links. NEXT_PUBLIC_APP_DOWNLOAD_URL is the primary CTA target; when it
# is unset the CTA scrolls to the download section instead.
NEXT_PUBLIC_APP_DOWNLOAD_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
